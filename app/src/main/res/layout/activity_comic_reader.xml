<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <!-- 左右翻页（ViewPager2） -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never" />

    <!-- 上下滚动（RecyclerView） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_gravity="center"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="#ff6b35"
        android:visibility="gone" />

    <!-- 顶部状态栏渐变遮罩 -->
    <View
        android:id="@+id/statusBarScrim"
        android:layout_gravity="top"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#66000000" />

    <!-- 顶部毛玻璃栏 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#D9161A2E"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="10dp">

        <TextView
            android:id="@+id/btnTopChapter"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="☰"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="@drawable/bg_comic_circle" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:singleLine="true"
            android:text="漫画"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnKeep"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="☆"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="@drawable/bg_comic_circle" />
    </LinearLayout>

    <!-- 底部控制栏 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#E6161A2E"
        android:paddingLeft="14dp"
        android:paddingTop="10dp"
        android:paddingRight="14dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="8dp">

        <SeekBar
            android:id="@+id/seekPage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:progressTint="#ff6b35"
            android:thumbTint="#ff6b35" />

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/btnPrevChapter"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="上一章"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:background="@drawable/bg_comic_capsule" />

            <TextView
                android:id="@+id/tvPageInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="1/10"
                android:textColor="#80FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnNextChapter"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="下一章"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:background="@drawable/bg_comic_capsule" />
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/btnDownload"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="下载"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btnMode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="模式"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btnAutoScroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="滚动"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btnSetting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="设置"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 设置面板遮罩 -->
    <View
        android:id="@+id/settingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#40000000"
        android:clickable="true"
        android:visibility="gone" />

    <!-- 设置面板 -->
    <LinearLayout
        android:id="@+id/settingPanel"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#F0161A2E"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <View
            android:layout_gravity="center_horizontal"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:background="#66FFFFFF" />

        <TextView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="浏览设置"
            android:textColor="#EEFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="翻页方向"
            android:textColor="#60FFFFFF"
            android:textSize="12sp" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/btnAnimHorizontal"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:text="← 左右 →"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="@drawable/bg_comic_capsule" />

            <TextView
                android:id="@+id/btnAnimVertical"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="↑ 上下 ↓"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="@drawable/bg_comic_capsule" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="分界图高度"
            android:textColor="#60FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnTransitionHeight"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="全屏"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:background="@drawable/bg_comic_capsule" />
    </LinearLayout>

    <!-- 章节抽屉遮罩 -->
    <View
        android:id="@+id/chapterOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#40000000"
        android:clickable="true"
        android:visibility="gone" />

    <!-- 章节抽屉 -->
    <LinearLayout
        android:id="@+id/chapterPanel"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#F6161A2E"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/chapterPanelTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="12dp"
            android:text="章节目录"
            android:textColor="#EEFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChapter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />
    </LinearLayout>
</FrameLayout>
